{
  "scheme": "heat_substation",
  "title": "ИТП: два циркуляционных насоса с ЧП, подпитка, регулирующие клапаны",
  "plc": {"id": "PLC1", "model": "generic", "cycle_ms": 100},
  "modules": [
    {"id": "DI1", "kind": "DI", "channels": 16, "base": 0, "signal": "24VDC"},
    {"id": "DO1", "kind": "DO", "channels": 8, "base": 0, "signal": "24VDC"},
    {"id": "AI1", "kind": "AI", "channels": 8, "base": 0, "signal": "4-20mA", "raw_lo": 0, "raw_hi": 27648},
    {"id": "AI2", "kind": "AI", "channels": 4, "base": 8, "signal": "4-20mA", "raw_lo": 0, "raw_hi": 27648},
    {"id": "AO1", "kind": "AO", "channels": 4, "base": 0, "raw_lo": 0, "raw_hi": 27648}
  ],
  "devices": [
    {"id": "U1", "class": "VFD", "tag": "U1", "freq_min": 25.0, "freq_max": 50.0},
    {"id": "M1", "class": "Motor", "tag": "M1", "power_kw": 4.0},
    {"id": "U2", "class": "VFD", "tag": "U2", "freq_min": 25.0, "freq_max": 50.0},
    {"id": "M2", "class": "Motor", "tag": "M2", "power_kw": 4.0},
    {"id": "KM3", "class": "Contactor", "tag": "KM3", "feedback_timeout_ms": 2000},
    {"id": "KK3", "class": "ThermalRelay", "tag": "KK3"},
    {"id": "M3", "class": "Motor", "tag": "M3", "power_kw": 0.75},
    {"id": "YV1", "class": "Solenoid", "tag": "YV1"},
    {"id": "XV1", "class": "Valve", "tag": "XV1", "travel_time_ms": 2000},
    {"id": "SQ1", "class": "LimitSwitch", "tag": "SQ1", "position": "open", "contact": "NO"},
    {"id": "SQ2", "class": "LimitSwitch", "tag": "SQ2", "position": "closed", "contact": "NC"},
    {"id": "TV1", "class": "AnalogActuator", "tag": "TV1", "range_lo": 0.0, "range_hi": 100.0, "unit": "%"},
    {"id": "TV2", "class": "AnalogActuator", "tag": "TV2", "unit": "%"},
    {"id": "HL1", "class": "Lamp", "tag": "HL1", "purpose": "авария"},
    {"id": "TT1", "class": "AnalogSensor", "tag": "TT1", "signal": "4-20mA", "range_lo": -50.0, "range_hi": 150.0, "unit": "C"},
    {"id": "TT2", "class": "AnalogSensor", "tag": "TT2", "signal": "4-20mA", "range_lo": -50.0, "range_hi": 150.0, "unit": "C"},
    {"id": "TT3", "class": "AnalogSensor", "tag": "TT3", "signal": "4-20mA", "range_lo": -50.0, "range_hi": 150.0, "unit": "C"},
    {"id": "TT4", "class": "AnalogSensor", "tag": "TT4", "signal": "4-20mA", "range_lo": -50.0, "range_hi": 150.0, "unit": "C"},
    {"id": "TT5", "class": "AnalogSensor", "tag": "TT5", "signal": "4-20mA", "range_lo": 0.0, "range_hi": 100.0, "unit": "C"},
    {"id": "PT1", "class": "AnalogSensor", "tag": "PT1", "signal": "4-20mA", "range_lo": 0.0, "range_hi": 10.0, "unit": "bar"},
    {"id": "PT2", "class": "AnalogSensor", "tag": "PT2", "signal": "4-20mA", "range_lo": 0.0, "range_hi": 10.0, "unit": "bar"},
    {"id": "PT3", "class": "AnalogSensor", "tag": "PT3", "signal": "4-20mA", "range_lo": 0.0, "range_hi": 16.0, "unit": "bar"},
    {"id": "TE1", "class": "AnalogSensor", "tag": "TE1", "signal": "4-20mA", "range_lo": -50.0, "range_hi": 50.0, "unit": "C"},
    {"id": "FT1", "class": "AnalogSensor", "tag": "FT1", "signal": "4-20mA", "range_lo": 0.0, "range_hi": 50.0, "unit": "m3/h"},
    {"id": "PS1", "class": "PressureSwitch", "tag": "PS1", "contact": "NC", "filter_ms": 1000},
    {"id": "LS1", "class": "LevelSwitch", "tag": "LS1", "contact": "NO"},
    {"id": "SQ3", "class": "LimitSwitch", "tag": "SQ3", "contact": "NO"}
  ],
  "connections": [
    {"from": "DO1.0", "to": "U1", "type": "wire"},
    {"from": "AO1.0", "to": "U1", "type": "wire"},
    {"from": "U1", "to": "M1", "type": "drives"},
    {"from": "U1", "to": "DI1.0", "type": "feedback", "contact": "NC"},

    {"from": "DO1.1", "to": "U2", "type": "wire"},
    {"from": "AO1.1", "to": "U2", "type": "wire"},
    {"from": "U2", "to": "M2", "type": "drives"},
    {"from": "U2", "to": "DI1.1", "type": "feedback", "contact": "NC"},

    {"from": "DO1.2", "to": "KM3", "type": "wire"},
    {"from": "KM3", "to": "KK3", "type": "drives"},
    {"from": "KK3", "to": "M3", "type": "drives"},
    {"from": "KM3", "to": "DI1.2", "type": "feedback", "contact": "NO"},
    {"from": "KK3", "to": "DI1.3", "type": "feedback", "contact": "NC"},

    {"from": "DO1.3", "to": "YV1", "type": "wire"},
    {"from": "YV1", "to": "XV1", "type": "drives"},
    {"from": "XV1", "to": "SQ1", "type": "drives"},
    {"from": "XV1", "to": "SQ2", "type": "drives"},
    {"from": "SQ1", "to": "DI1.4", "type": "wire"},
    {"from": "SQ2", "to": "DI1.5", "type": "wire"},

    {"from": "AO1.2", "to": "TV1", "type": "wire"},
    {"from": "AO1.3", "to": "TV2", "type": "wire"},
    {"from": "DO1.4", "to": "HL1", "type": "wire"},

    {"from": "TT1", "to": "AI1.0", "type": "wire"},
    {"from": "TT2", "to": "AI1.1", "type": "wire"},
    {"from": "TT3", "to": "AI1.2", "type": "wire"},
    {"from": "TT4", "to": "AI1.3", "type": "wire"},
    {"from": "TT5", "to": "AI1.4", "type": "wire"},
    {"from": "PT1", "to": "AI1.5", "type": "wire"},
    {"from": "PT2", "to": "AI1.6", "type": "wire"},
    {"from": "PT3", "to": "AI1.7", "type": "wire"},
    {"from": "TE1", "to": "AI2.0", "type": "wire"},
    {"from": "FT1", "to": "AI2.1", "type": "wire"},

    {"from": "PS1", "to": "DI1.6", "type": "wire"},
    {"from": "LS1", "to": "DI1.7", "type": "wire"},
    {"from": "SQ3", "to": "DI1.8", "type": "wire"}
  ]
}
